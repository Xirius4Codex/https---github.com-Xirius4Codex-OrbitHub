<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OrbitHub.ViewModels"
        xmlns:models="using:OrbitHub.Models"
        xmlns:views="using:OrbitHub.Views"
        x:Class="OrbitHub.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Orbit Hub"
        Width="1100" Height="700"
        Background="#0F1117"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <views:PathToImageConverter x:Key="PathToImageConverter"/>
        <views:BoolToTabColorConverter x:Key="TabBgConverter"/>
        <views:BoolToTabTextColorConverter x:Key="TabFgConverter"/>
    </Window.Resources>

    <Grid>
        <!-- ============ PANTALLA DE CARGA (SPLASH SCREEN) ============ -->
        <Grid IsVisible="{Binding IsLoading}" Background="#0F1117">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="24">
                <Image Source="/Assets/splash.png" 
                       Width="400" 
                       Stretch="Uniform" 
                       HorizontalAlignment="Center"/>
                
                <ProgressBar IsIndeterminate="True" Width="300" Height="8" 
                             Foreground="#4F7CFF" Background="#252A36"
                             CornerRadius="4" Margin="0,20,0,0"/>
                
                <TextBlock Text="Cargando biblioteca..." FontSize="14" Foreground="#8A93A6" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ============ PANTALLA BIENVENIDA ============ -->
        <!-- Cambiado a ShowWelcomeScreen -->
        <Grid IsVisible="{Binding ShowWelcomeScreen}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="24">
                <TextBlock Text="🛰️" FontSize="80" HorizontalAlignment="Center"/>
                <TextBlock Text="ORBIT HUB" FontSize="48" FontWeight="Bold"
                           Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                <TextBlock Text="Tu biblioteca. Tus juegos. Tus reglas."
                           FontSize="18" Foreground="#8A93A6" HorizontalAlignment="Center"/>
                <Button Content="Seleccionar Biblioteca"
                        HorizontalAlignment="Center"
                        Padding="32,14" FontSize="16" FontWeight="SemiBold"
                        Background="#4F7CFF" Foreground="White"
                        CornerRadius="10"
                        Click="OnSelectLibraryClick"/>
            </StackPanel>
        </Grid>

        <!-- ============ PANTALLA BIBLIOTECA ============ -->
        <Grid IsVisible="{Binding HasLibrary}" RowDefinitions="Auto,*">
            <!-- Header -->
            <Border Grid.Row="0" Background="#161A22" Padding="24,16">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="16">
                    <!-- Fila 1: Logo, Buscador, Botón Ordenar y Botones -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="🛰️" FontSize="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Orbit Hub" FontSize="20" FontWeight="Bold"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, Mode=TwoWay}"
                                 PlaceholderText="🔍 Buscar juego..."
                                 Background="#252A36" Foreground="White"
                                 BorderThickness="0" CornerRadius="8"
                                 Padding="12,8" Margin="24,0"
                                 VerticalAlignment="Center"/>

                        <Button Grid.Column="2"
                                Command="{Binding ToggleSortOrderCommand}"
                                Background="#252A36" Foreground="White"
                                Padding="16,8" CornerRadius="8"
                                Margin="0,0,8,0"
                                ToolTip.Tip="Cambiar orden (A-Z / Z-A)">
                            <Button.Styles>
                                <Style Selector="Button">
                                    <Setter Property="Content" Value="🔤 A-Z"/>
                                </Style>
                                <Style Selector="Button[Tag=False]">
                                    <Setter Property="Content" Value="🔤 Z-A"/>
                                </Style>
                            </Button.Styles>
                            <Button.Tag>
                                <Binding Path="SortAscending"/>
                            </Button.Tag>
                        </Button>

                        <Button Grid.Column="3"
                                Content="🔄 Reescanear"
                                Command="{Binding RescanCommand}"
                                Background="#252A36" Foreground="White"
                                Padding="16,8" CornerRadius="8"
                                Margin="0,0,8,0"/>

                        <Button Grid.Column="4"
                                Content="Cambiar Biblioteca"
                                Background="#252A36" Foreground="White"
                                Padding="16,8" CornerRadius="8"
                                Click="OnSelectLibraryClick"/>
                    </Grid>

                    <!-- Fila 2: Pestañas -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="🎮 Todos los juegos" 
                                Command="{Binding ShowAllCommand}"
                                Padding="16,8" CornerRadius="8"
                                Background="{Binding !ShowFavoritesOnly, Converter={StaticResource TabBgConverter}}"
                                Foreground="{Binding !ShowFavoritesOnly, Converter={StaticResource TabFgConverter}}"/>

                        <Button Content="⭐ Favoritos" 
                                Command="{Binding ShowFavoritesCommand}"
                                Padding="16,8" CornerRadius="8"
                                Background="{Binding ShowFavoritesOnly, Converter={StaticResource TabBgConverter}}"
                                Foreground="{Binding ShowFavoritesOnly, Converter={StaticResource TabFgConverter}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Grid de juegos -->
            <ScrollViewer Grid.Row="1" Padding="24">
                <ItemsControl ItemsSource="{Binding Games}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:Game">
                            <Border Width="220" Height="330"
                                    Margin="8"
                                    Background="#161A22"
                                    CornerRadius="12"
                                    ClipToBounds="True"
                                    DoubleTapped="OnGameDoubleTapped"
                                    Tag="{Binding}">

                                <Border.Styles>
                                    <Style Selector="Border:pointerover">
                                        <Setter Property="Background" Value="#1E2430"/>
                                        <Setter Property="BorderBrush" Value="#4F7CFF"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </Style>
                                </Border.Styles>

                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="▶ Lanzar"
                                                  Command="{Binding $parent[Window].DataContext.LaunchGameCommand}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="📁 Abrir carpeta"
                                                  Command="{Binding $parent[Window].DataContext.OpenFolderCommand}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="🖼️ Cambiar Carátula"
                                                  Click="OnChangeCoverClick"/>
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <Grid RowDefinitions="280,*,Auto">
                                    <Panel Grid.Row="0" Background="#252A36">
                                        <Image Source="{Binding CoverPath, Converter={StaticResource PathToImageConverter}}" 
                                               Stretch="UniformToFill"
                                               IsVisible="{Binding CoverPath, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                        
                                        <TextBlock Text="🎮" FontSize="80"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding CoverPath, Converter={x:Static ObjectConverters.IsNull}}"/>
                                    </Panel>

                                    <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="8"
                                            Background="#80000000" 
                                            Padding="8,4" CornerRadius="50"
                                            Command="{Binding $parent[Window].DataContext.ToggleFavoriteCommand}"
                                            CommandParameter="{Binding}">
                                        <Button.Styles>
                                            <Style Selector="Button">
                                                <Setter Property="Content" Value="☆"/>
                                                <Setter Property="Foreground" Value="#8A93A6"/>
                                                <Setter Property="FontSize" Value="20"/>
                                            </Style>
                                            <Style Selector="Button[Tag=True]">
                                                <Setter Property="Content" Value="★"/>
                                                <Setter Property="Foreground" Value="Gold"/>
                                            </Style>
                                        </Button.Styles>
                                        <Button.Tag>
                                            <Binding Path="IsFavorite" />
                                        </Button.Tag>
                                    </Button>

                                    <StackPanel Grid.Row="1" Margin="12,12,12,4" Spacing="4">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Doble clic para jugar"
                                                   Foreground="#8A93A6"
                                                   FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>